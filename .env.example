# FunPlay Systems website: environment variables.
# Copy to .env.local for local development; set the same names in Vercel > Project > Settings >
# Environment Variables for Production (and Preview if you want forms to work there).
# Never commit real values. See docs/FORMS.md for details.

# --- Mailgun (required for every form to send email) ---
# Private API key from Mailgun > API Security (starts with "key-" or is a long hex string).
MAILGUN_API_KEY=
# Sending domain verified in Mailgun, e.g. mg.funplaysystems.com
MAILGUN_DOMAIN=
# "us" (default) or "eu", matching the region the Mailgun domain was created in.
MAILGUN_REGION=us
# Sender shown on all emails; must be an address on MAILGUN_DOMAIN's verified domain.
MAIL_FROM="FunPlay Website <webmaster@funplaysystems.com>"
# Inbox that receives contact, career, newsletter and catalogue-download leads.
LEAD_RECIPIENT=marketing@funplaysystems.com
# Optional comma-separated BCC list for lead emails, e.g. sales@funplaysystems.com,owner@example.com
LEAD_BCC=

# --- Catalogue download verification (required for the homepage popup) ---
# Random secret of at least 32 characters used to sign the verification cookie (openssl rand -base64 48).
VERIFY_SECRET=
# Optional: catalogue handed out after verification (default /files/Funplay-Originals.pdf).
CATALOGUE_URL=

# --- Mailchimp (optional; newsletter sign-ups are still emailed to LEAD_RECIPIENT without it) ---
# Mailchimp API key including its datacenter suffix, e.g. xxxxxxxx-us21
MAILCHIMP_API_KEY=
# Audience (list) ID from Mailchimp > Audience > Settings > Audience name and defaults.
MAILCHIMP_LIST_ID=

# --- Google reCAPTCHA v3 (optional; set both or neither) ---
# Public site key; rendered as <html data-recaptcha> so the forms fetch a token. Needs a rebuild.
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=
# Secret key; when set, every form (except the code-entry step) requires a token scoring >= 0.5.
RECAPTCHA_SECRET_KEY=

# --- Optional ---
# Extra origins allowed to post to /api/* besides the site's own host, comma separated (e.g. a staging domain).
ALLOWED_ORIGINS=
# Developer only: build just these pages, e.g. ONLY_PATHS="/,/about-us.html"
ONLY_PATHS=
